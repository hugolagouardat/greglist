generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdType {
  OFFER
  REQUEST
}

enum AdCategory {
  HOME_HELP
  GARDENING
  TUTORING
  IT_SUPPORT
  BEAUTY_WELLNESS
  EVENTS
  MOVING_DELIVERY
  OTHER
}

enum PriceMode {
  FREE
  HOURLY
  FIXED
}

enum ServiceTerm {
  REMOTE
  AT_PROVIDER
  AT_CUSTOMER
}

enum AdStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        Int      @id @default(autoincrement())
  pseudo    String   @unique
  city      String
  bio       String?
  password  String
  ads       Ad[]
  ownedConversations       Conversation[] @relation("ConversationOwner")
  participatingConversations Conversation[] @relation("ConversationParticipant")
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ad {
  id            Int           @id @default(autoincrement())
  type          AdType
  title         String
  description   String
  category      AdCategory
  city          String
  availability  String?
  priceMode     PriceMode
  priceValue    Decimal?      @db.Decimal(10, 2)
  serviceTerms  ServiceTerm[]
  status        AdStatus      @default(DRAFT)
  ownerId       Int
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Conversation {
  id            Int      @id @default(autoincrement())
  adId          Int
  ownerId       Int
  participantId Int
  ad            Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  owner         User     @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participant   User     @relation("ConversationParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([adId, ownerId, participantId])
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  conversationId Int
  senderId       Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}